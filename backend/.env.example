# Brevo (Sendinblue) API key — Settings > SMTP & API > API Keys in Brevo.
BREVO_API_KEY=your_key_here

# Optional: numeric ID of the Brevo list new subscribers get added to.
# Contacts > Lists in Brevo. Leave empty to add contacts without a list.
BREVO_LIST_ID=

# Port the API server listens on.
PORT=3001

# Origin allowed to call this API (your site's URL, e.g. https://rottencherry.co).
# Use * only for local testing, never in production.
FRONTEND_ORIGIN=*

# Supabase — used only by backend/scripts/create-admin-user.js (never sent to the browser).
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=
# The SECRET key (starts with sb_secret_...). Never expose this in frontend code.
SUPABASE_SECRET_KEY=
# Email used to log into /admin.
ADMIN_EMAIL=

# Optional: comma-separated IPs allowed to reach /admin at all (everyone else
# gets a 404, as if it doesn't exist). Leave empty to allow any IP — the
# Supabase login is still required either way. See the comment above the
# matching middleware in server.js before relying on this behind a proxy.
ADMIN_ALLOWED_IPS=
